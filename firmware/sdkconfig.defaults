# PicoTTS is kept out of fox.bin. Its English-US TA/SG resources are flashed
# into the dedicated picotts_ta/picotts_sg partitions by the component build.
# If PicoTTS cannot be acquired in CI, the local SAM voice remains available.
CONFIG_PICOTTS_LANGUAGE_EN_US=y
CONFIG_PICOTTS_RESOURCE_MODE_PARTITION=y
CONFIG_PICOTTS_TA_PARTITION="picotts_ta"
CONFIG_PICOTTS_SG_PARTITION="picotts_sg"

CONFIG_FREERTOS_HZ=1000
